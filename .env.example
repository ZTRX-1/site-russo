# ============================================
# Analytics / SEO — cole os IDs quando tiver
# ============================================

# Google Tag Manager container ID (formato: GTM-XXXXXXX)
# Enquanto vazio, o GTM não é carregado (dev fica limpo).
VITE_GTM_ID=

# GA4 Measurement ID (formato: G-XXXXXXXXXX)
# Opcional se você já configura GA4 dentro do GTM.
VITE_GA_ID=

# Google Search Console — valor do meta tag de verificação
# (só o content, sem as aspas). Ex: "abc123XYZ..."
VITE_GSC_VERIFICATION=